{
    "name": "hirasso/phpstan-illuminate-collections",
    "description": "PHPStan narrowing for filter()/reject()/where() on illuminate/collections, without Larastan",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": ["phpstan", "phpstan-extension", "illuminate", "collections", "static analysis"],
    "authors": [
        {
            "name": "Rasso Hilber",
            "email": "mail@rassohilber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/collections": "^11 || ^12 || ^13",
        "phpstan/phpstan": "^2.3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12"
    },
    "autoload": {
        "psr-4": {
            "Hirasso\\PHPStanIlluminateCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hirasso\\PHPStanIlluminateCollections\\Tests\\": "tests/"
        },
        "classmap": ["tests/data"]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "bash tools/extract-phpstan-src.sh",
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
